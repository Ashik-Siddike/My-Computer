# =============================================================================
# MY COMPUTER E-COMMERCE - PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. BACKEND SETTINGS (Configure in Render Dashboard Environment Variables)
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas Connection String (Must be IP whitelisted 0.0.0.0/0 in Atlas)
MONGODB_URI=mongodb+srv://mycomputer_admin:mycomputer2026@cluster0.ab12cd.mongodb.net/my_computer?retryWrites=true&w=majority

# Database Name in Cluster
DATABASE_NAME=my_computer

# JWT Authentication Secret (Use a strong random string)
JWT_SECRET=mycomputer_enterprise_secure_jwt_token_secret_2026

# Default Super Administrator Account (Initial seed & fallback)
ADMIN_NAME=Store Admin
ADMIN_EMAIL=salesmycomputer2025@gmail.com
ADMIN_PASSWORD=mycomputer

# Delivery Charges (BDT)
DHAKA_DELIVERY_CHARGE=70
OUTSIDE_DHAKA_DELIVERY_CHARGE=140

# Server Port (Render dynamically assigns this, defaults to 10000 on Render)
PORT=10000

# Node Version (Requires Node 22+ for native TypeScript strip types)
NODE_VERSION=22.14.0

# ─────────────────────────────────────────────────────────────────────────────
# 2. FRONTEND SETTINGS (Configure in Vercel Dashboard Environment Variables)
# ─────────────────────────────────────────────────────────────────────────────

# URL of your deployed Render backend (without trailing slash)
# Example: https://my-computer-api.onrender.com
# Leave empty for local development or when deployed together on Render
VITE_API_URL=
